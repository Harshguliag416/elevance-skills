# ----------------------------------------------------------------------------
# Backend environment variables
# Copy to `.env` and fill in real values. Never commit the real .env.
# ----------------------------------------------------------------------------

# MongoDB connection string (already used by the existing app)
DATABASE_URL=mongodb+srv://user:pass@cluster/dbname

# HTTP port (optional; defaults to 5000)
PORT=5000

# --- OTP security -----------------------------------------------------------
# Server-side pepper used to HMAC the OTP before storage. Min 16 chars.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=change-me-to-a-long-random-string

# --- Email (SMTP via Nodemailer) --------------------------------------------
# If these are unset, the server runs in dev mode and logs OTPs to the console
# instead of emailing them (and never returns them over the API).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM=InternArea <no-reply@internarea.com>

# --- Firebase Admin (token verification) ------------------------------------
# Provide ONE of the following. If neither is set, set ALLOW_INSECURE_AUTH=true
# for local development only.
# The full service-account JSON on one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# Or base64-encode the JSON (recommended for single-line env on hosts):
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50...

# Development-only escape hatch. NEVER set to true in production.
ALLOW_INSECURE_AUTH=false

# --- Razorpay (resume fee + subscription plans) -------------------------------
# If unset, the server runs in dev mode: orders get "order_dev_*" ids and the
# frontend shows a "Simulate payment" button instead of the Razorpay modal.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Development OTP convenience ----------------------------------------------
# Optional. When set, this 6-digit code is accepted as a valid OTP everywhere
# (French language, resume payment, Chrome login) so flows can be demoed without
# reading server logs. NEVER set in production.
# OTP_DEV_CODE=123456
